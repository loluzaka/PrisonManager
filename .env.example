# Copy this file to ".env" (which is git-ignored) and fill in your own values.

# ---- ACTIVE DATABASE: POSTGRESQL ------------------------------------------
POSTGRES_CONTAINER=prison-postgres
POSTGRES_DB=prison_db
POSTGRES_PORT=5432
POSTGRES_LOCAL_PASSWORD=change_me_local_postgres_password
POSTGRES_DEMO_PASSWORD=change_me_demo_password
# Local URL for the Flask UI. The UI overrides the URL's user/password with
# the selected PRISON_U_* PostgreSQL login and the password entered at sign-in.
POSTGRES_URL=postgresql://localhost:5432/prison_db
# Optional explicit cloud URL overrides. Neon CLI DATABASE_URL values are used
# automatically when these are blank.
POSTGRES_ADMIN_URL=
# Neon CLI-managed values after `neon env pull` (keep actual values private).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
PRISON_APP_API_KEY=change_me_random_server_only_key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# ---- LEGACY ORACLE CONFIG (reference only; no longer used by the active app) -
PRISON_CONTAINER=prison-oracle
PRISON_DB_PORT=1521
PRISON_DB_SERVICE=FREEPDB1
PRISON_SYS_PASSWORD=change_me_sys_password
PRISON_OWNER_PASSWORD=change_me_owner_password
PRISON_DEMO_PASSWORD=change_me_demo_password

# ---- LEGACY ORACLE CLOUD CONFIG --------------------------------------------
# Download the wallet zip from the OCI console, unzip it into a folder OUTSIDE the repo
# (or into cloud/wallet/, which is git-ignored) and point TNS_ADMIN at it.
# PRISON_CLOUD_TNS is a service alias from the wallet's tnsnames.ora, e.g. prisondb_high
TNS_ADMIN=C:\path\to\unzipped\wallet
PRISON_CLOUD_TNS=prisondb_high
PRISON_CLOUD_ADMIN_PASSWORD=change_me_cloud_admin_password
PRISON_CLOUD_OWNER_PASSWORD=change_me_cloud_owner_password
PRISON_CLOUD_DEMO_PASSWORD=change_me_cloud_demo_password
PRISON_CLOUD_WALLET_PASSWORD=

# ---- WEB UI ---------------------------------------------------------------
# Set a stable random value before hosting beyond local development.
UI_SECRET_KEY=change_me_random_secret_key
# Set UI_HTTPS=true when the UI is served through HTTPS.
UI_HTTPS=false
